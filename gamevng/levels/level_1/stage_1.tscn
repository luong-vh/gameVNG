[sub_resource type="GDScript" id="GDScript_7xf2g"]
resource_name = "light_mask"
script/source = "extends Sprite2D
@export var light_viewport: SubViewport
@export var opacity: float = 0.5

func _ready():
	# Reparent to camera if not already
	var camera = get_viewport().get_camera_2d()
	if camera and get_parent() != camera:
		reparent(camera)
	
	centered = true
	position = Vector2.ZERO  # Relative to camera
	modulate.a = opacity

func _physics_process(delta: float) -> void:
	texture = light_viewport.get_texture()
"

