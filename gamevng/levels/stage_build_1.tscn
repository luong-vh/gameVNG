[sub_resource type="GDScript" id="GDScript_lxmcf"]
resource_name = "mini_boss_control"
script/source = "extends Node2D

@export var enemy_list: Array[EnemyCharacter]
@export var door: Node2D

var all_enemies_dead: bool = false

func _ready():
	# Connect to each enemy's death signal
	for enemy in enemy_list:
		if enemy != null:
			# Assuming your enemy has a \"died\" signal
			enemy.died.connect(_on_enemy_died)

func _on_enemy_died():
	# Check if all enemies are dead
	check_all_enemies_dead()

func check_all_enemies_dead():
	if all_enemies_dead:
		return  # Already processed
	var all_dead = true
	for enemy in enemy_list:
		if enemy != null and enemy.health > 0:
			all_dead = false
			break
	
	if all_dead:
		all_enemies_dead = true
		open_door()

func open_door():
	if door == null:
		return
	door.open()
	print(\"All enemies defeated! Opening door...\")
"

